config_version=5
[application]
config/name="Tuvlo Homestead Runtime"
run/main_scene="res://scenes/homestead.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=900
window/size/viewport_height=700
window/stretch/mode="disabled"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.ios="metal"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
[environment]
defaults/default_clear_color=Color(0.72,0.82,0.78,1)
