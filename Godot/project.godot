config_version=5
[application]

config/icon="res://assets/icon/app_icon_1024.png"
config/name="Tuvlo World"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.898039,0.886275,0.831373,1)
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="disabled"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/driver.ios="metal"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
[environment]
defaults/default_clear_color=Color(0.72,0.82,0.78,1)

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[tuvlo_world]

quick_play=true

[shader_globals]

ground_grade={
"type": "vec4",
"value": Vector4(1, 1, 1, 0)
}
ground_hearth={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
ground_pool={
"type": "vec4",
"value": Vector4(0, 0, 100, 200)
}
ground_air={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
